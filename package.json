{
  "name": "kimi-plugin-cross-platform",
  "version": "0.1.0",
  "description": "Cross-platform kit for integrating Kimi CLI into Claude Code, Codex CLI, and Antigravity CLI",
  "type": "module",
  "workspaces": [
    "core",
    "adapters/claude-code",
    "adapters/codex-cli",
    "adapters/antigravity-cli"
  ],
  "scripts": {
