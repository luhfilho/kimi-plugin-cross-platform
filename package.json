    "test:unit": "node --test tests/unit/**/*.test.mjs",
    "test:integration": "node --test tests/integration/**/*.test.mjs",
    "test:adapters": "node --test tests/adapters/**/*.test.mjs",
    "lint": "echo 'Linting not yet configured'",
    "format": "echo 'Formatting not yet configured'"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
